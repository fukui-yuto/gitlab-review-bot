# GitLab
GITLAB_URL=http://localhost:8929
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=test-webhook-secret-12345

# LLM Provider: "gemini" / "openai" / "mock" (テスト用)
LLM_PROVIDER=gemini

# LLM API Keys (使用するプロバイダに応じて設定)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Proxy (optional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
